# 运行时产物（数据库与日志，不入库）
server/store/*.db
server/store/*.db-wal
server/store/*.db-shm
server/store/*.log

# 语音服务运行日志（P11；asr_example_zh.wav/webm 是自测样本，保留入库）
voice/*.log

# 数据库备份（本地快照，不入库）
server/store/backup/
*.bak

# 本地密钥与个性化配置（含 API Key，严禁入库）
server/.env.json

# 若将来引入 npm 依赖（当前刻意零依赖）
node_modules/
package-lock.json

# 临时目录/系统文件
.workbuddy/
.tmp*
.DS_Store
Thumbs.db

# 交付产物（源码 zip 是「打包结果」，不是源码本身）
*.zip
